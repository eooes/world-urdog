import * as THREE from 'three';
import { terrainHeight } from './terrain.js';

/* ========================================================================
   Sky: Children of the Light – inspired grass field
   ========================================================================
   Key observations from Sky reference:
   - Flat single-plane sprites, NOT crossed quads
   - Blunt / flat-topped tips (not sharp triangles)
   - Visible ground between blades (not solid carpet)
   - 3 colour bands: dark base → mid green body → bright highlight tip
   - ~4:1 to 5:1 height:width ratio
   ======================================================================== */

/* ── Blade-type descriptors ─────────────────────────────────────────── */
const TYPES = {
  // Primary: tall thin single-plane with flat top (Sky's main grass)
  field:  { count: 28_000, width: 0.028, hMin: 0.40, hMax: 0.85, crossed: false, flatTop: true },
  // Crossed accent blades for depth (only near camera)
  accent: { count: 12_000, width: 0.022, hMin: 0.30, hMax: 0.65, crossed: true,  flatTop: true },
  // Short bushy tufts (ground coverage + shadow layer)
  tuft:   { count:  8_000, width: 0.100, hMin: 0.18, hMax: 0.42, crossed: false, flatTop: false },
};

/* ── Sky-inspired palette (boosted ~30% brightness for bloom glow) ───── */
const PALETTE = [
  { hex: 0xD4F0A0, w: 0.15 },   // bright pale dew lime (was 0xAED581)
  { hex: 0xC0EE80, w: 0.12 },   // bright golden green (was 0x9CCC65)
  { hex: 0xADD85E, w: 0.23 },   // vibrant spring grass (was 0x8BC34A)
  { hex: 0x9BD055, w: 0.20 },   // warm bright meadow (was 0x7CB342)
  { hex: 0x82BF48, w: 0.15 },   // rich luminous green (was 0x689F38)
  { hex: 0x6AAA3E, w: 0.10 },   // mid-bright forest (was 0x558B2F)
  { hex: 0x54C059, w: 0.05 },   // bright jewel accent (was 0x43A047)
];

// Tuft palette — warmer, golden tones, boosted for bloom
const TUFT_PALETTE = [
  { hex: 0xE0EA50, w: 0.25 },   // bright warm yellow-green (was 0xC0CA33)
  { hex: 0xD4F0A0, w: 0.25 },   // bright pale lime (was 0xAED581)
  { hex: 0xC0EE80, w: 0.20 },   // bright golden green (was 0x9CCC65)
  { hex: 0xADD85E, w: 0.20 },   // vibrant spring grass (was 0x8BC34A)
  { hex: 0xF0F570, w: 0.10 },   // brilliant golden-lime (was 0xD4E157)
];

function pickColour(rng, palette = PALETTE) {
  let acc = 0;
  for (const c of palette) { acc += c.w; if (rng <= acc) return c.hex; }
  return palette[palette.length - 1].hex;
}

/* ── Geometry: flat-topped (blunt) blades like Sky ───────────────────── */
function makeBladeGeo(width, crossed, flatTop) {
  const W = width;
  const geo = new THREE.BufferGeometry();
  const positions = [], uvs = [], vCol = [];

  const pushQuad = (x0, z0, x1, z1, x2, z2, x3, z3) => {
    positions.push(x0, 0.0, z0, x1, 0.0, z1, x2, 1.0, z2, x3, 1.0, z3);
    uvs.push(0, 0, 1, 0, 0, 1, 1, 1);
    // 3-band colour: [base=dark shadow] → [tip=bright highlight]
    [0.0, 0.0, 1.0, 1.0].forEach(h => {
      // Boosted bands: base lifted, highlight widened so top ~65% of blade exceeds bloom threshold
      const band = h < 0.10 ? 0.30 + h * 1.00           // base shadow: 0.30→0.40
                 : h < 0.35 ? 0.40 + (h - 0.10) * 1.80  // mid body:   0.40→0.85
                 :            0.85 + (h - 0.35) * 0.23;  // highlight:  0.85→1.00
      vCol.push(band, band, band);
    });
  };

  const hw = W / 2;

  if (crossed) {
    const tipW = flatTop ? hw * 0.90 : hw * 0.25;
    pushQuad(-hw, 0, hw, 0, -tipW, 0, tipW, 0);         // Quad A
    pushQuad(0, -hw, 0, hw, 0, -tipW, 0, tipW);         // Quad B
    geo.setIndex([0, 1, 2, 1, 3, 2, 4, 5, 6, 5, 7, 6]);
  } else {
    const tipW = flatTop ? hw * 0.92 : hw * 0.20;        // blunt top: 92% of base width (nearly flat)
    pushQuad(-hw, 0, hw, 0, -tipW, 0, tipW, 0);
    geo.setIndex([0, 1, 2, 1, 3, 2]);
  }

  geo.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
  geo.setAttribute('uv',       new THREE.Float32BufferAttribute(uvs, 2));
  geo.setAttribute('color',    new THREE.Float32BufferAttribute(vCol, 3));
  geo.computeVertexNormals();
  return geo;
}

/* ── Wind shader ─────────────────────────────────────────────────────── */
function injectWindShader(material, uniforms) {
  material.onBeforeCompile = shader => {
    if (shader.uniforms) Object.assign(shader.uniforms, uniforms);

    shader.vertexShader = shader.vertexShader.replace(
      '#include <common>',
      `#include <common>
uniform float uTime;
uniform float uWindX;
uniform float uWindZ;
uniform float uWindS;
`);

    shader.vertexShader = shader.vertexShader.replace(
      '#include <begin_vertex>',
      `vec3 transformed = vec3(position);

float ipx = instanceMatrix[3][0];
float ipz = instanceMatrix[3][2];

// Unified travelling wave (Sky's gentle rolling motion)
float wave  = sin(uTime * 0.58 + ipx * 0.22) * cos(uTime * 0.44 + ipz * 0.19);
wave       += sin(uTime * 0.95 + (ipx + ipz) * 0.15) * 0.35;
wave       += sin(uTime * 0.30 + ipx * 0.35 - ipz * 0.25) * 0.20;

float micro = sin(ipx * 4.91 + ipz * 6.73 + uTime * 1.7) * 0.06;
float gust  = wave + micro;

float bladeH = clamp(position.y, 0.0, 1.0);
float sway   = bladeH * bladeH * gust * uWindS;

transformed.x += uWindX * sway * 0.55;
transformed.z += uWindZ * sway * 0.55;
`);

    material.userData._shader = shader;
  };
}

/* ── Exclusion zones ─────────────────────────────────────────────────── */
function inExclusionZone(x, z) {
  if (Math.abs(x) < 38 && z < -90 && z > -148) return true;
  if (Math.abs(x + 60) < 16 && z > -14 && z < 54) return true;
  return false;
}

/* ── Main ────────────────────────────────────────────────────────────── */
export function buildGrassField(scene) {
  const dummy  = new THREE.Object3D();
  const colour = new THREE.Color();

  const windUniforms = {
    uTime:  { value: 0 },
    uWindX: { value: 1 },
    uWindZ: { value: 0 },
    uWindS: { value: 0.7 },
  };

  const meshes = [];

  for (const [name, cfg] of Object.entries(TYPES)) {
    /* -- Geometry -- */
    const geo = makeBladeGeo(cfg.width, cfg.crossed, cfg.flatTop);

    /* -- Material -- */
    const mat = new THREE.MeshBasicMaterial({
      vertexColors: true,
      side:         THREE.DoubleSide,
      transparent:  true,
      fog:          true,
      depthWrite:   true,
    });

    injectWindShader(mat, windUniforms);

    /* -- InstancedMesh -- */
    const mesh = new THREE.InstancedMesh(geo, mat, cfg.count);
    mesh.receiveShadow = false;
    mesh.castShadow    = false;

    let placed = 0, attempts = 0;
    const isTuft = name === 'tuft';

    while (placed < cfg.count && attempts < cfg.count * 5) {
      attempts++;
      const a = Math.random() * Math.PI * 2;
      const r = 6 + Math.random() * 194;
      const x = Math.cos(a) * r;
      const z = Math.sin(a) * r;

      if (inExclusionZone(x, z)) continue;

      const y = terrainHeight(x, z);

      let h;
      if (Math.random() < 0.4) {
        h = cfg.hMin + Math.random() * (cfg.hMax - cfg.hMin) * 0.35;
      } else {
        h = cfg.hMin + (cfg.hMax - cfg.hMin) * 0.25 + Math.random() * (cfg.hMax - cfg.hMin) * 0.75;
      }

      const leanX = (Math.random() - 0.5) * 0.30;
      const leanZ = (Math.random() - 0.5) * 0.20;

      if (isTuft) {
        // Cluster tuft blades: place 3-6 around a centre point
        const clusterSize = 3 + Math.floor(Math.random() * 4); // 3-6 per cluster
        for (let ci = 0; ci < clusterSize && placed < cfg.count; ci++) {
          const ox = (Math.random() - 0.5) * 0.25;
          const oz = (Math.random() - 0.5) * 0.25;
          const ch = cfg.hMin + Math.random() * (cfg.hMax - cfg.hMin);
          dummy.position.set(x + ox, y, z + oz);
          dummy.rotation.set(
            (Math.random() - 0.5) * 0.5,
            Math.random() * Math.PI * 2,
            (Math.random() - 0.5) * 0.4,
          );
          dummy.scale.setScalar(ch);
          dummy.updateMatrix();
          mesh.setMatrixAt(placed, dummy.matrix);
          colour.setHex(pickColour(Math.random(), TUFT_PALETTE));
          mesh.setColorAt(placed, colour);
          placed++;
        }
      } else {
        dummy.position.set(x, y, z);
        dummy.rotation.set(leanX, Math.random() * Math.PI * 2, leanZ);
        dummy.scale.setScalar(h);
        dummy.updateMatrix();
        mesh.setMatrixAt(placed, dummy.matrix);
        colour.setHex(pickColour(Math.random()));
        mesh.setColorAt(placed, colour);
        placed++;
      }
    }

    if (placed < cfg.count) {
      dummy.position.set(0, -999, 0);
      dummy.scale.setScalar(0.001);
      dummy.updateMatrix();
      colour.setHex(0x000000);
      for (let i = placed; i < cfg.count; i++) {
        mesh.setMatrixAt(i, dummy.matrix);
        mesh.setColorAt(i, colour);
      }
    }

    mesh.instanceMatrix.needsUpdate = true;
    if (mesh.instanceColor) mesh.instanceColor.needsUpdate = true;
    scene.add(mesh);
    meshes.push(mesh);
  }

  return {
    meshes,
    setWind(dirVec, strength, t) {
      windUniforms.uTime.value  = t;
      windUniforms.uWindX.value = dirVec.x;
      windUniforms.uWindZ.value = dirVec.z;
      windUniforms.uWindS.value = strength;
    },
  };
}
